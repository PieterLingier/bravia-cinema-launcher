<?xml version="1.0" encoding="utf-8"?>
<!-- Key filtering, plus Plex's window events (type and class name only, to see when Plex has
     loaded). No access to screen content. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewFocused"
    android:packageNames="com.plexapp.android"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/button_service_description"
    android:notificationTimeout="0" />
